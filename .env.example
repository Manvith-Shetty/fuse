# copy to .env and fill in. never commit .env

# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
OWNER_ACCOUNT=yourname.testnet
WALLET_CONTRACT=fuse.yourname.testnet
AGENT_ACCOUNT=agent.yourname.testnet
# testnet NEP-141 token the wallet holds (set after deploying or choosing one)
TOKEN_CONTRACT=

# chip
SERIAL_PORT=/dev/cu.usbserial-0001
SERIAL_BAUD=115200
# set to 1 to run the bridge against the software-simulated chip (labelled SIMULATED everywhere)
SIMULATE_CHIP=0

# models
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
ANTHROPIC_API_KEY=

# chain signatures (phase 7) [VERIFY ids before use]
CHAIN_SIG_CONTRACT=v1.signer-prod.testnet
SEPOLIA_RPC_URL=
