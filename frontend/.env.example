# copy to .env. only VITE_* keys reach the browser; these two are read by vite.config.ts for the dev proxy.
# bridge API (bridge/: `npm run fuse -- serve`), proxied at /api/bridge
VITE_BRIDGE_URL=http://127.0.0.1:7777
# agent red-team service (agent/: `serve --port 7778`), proxied at /api/agent
VITE_AGENT_URL=http://127.0.0.1:7778
